{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "configure-clang-debug",
      "binaryDir": "${sourceDir}/build-clang-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "configure-clang-tidy",
      "inherits": "configure-clang-debug",
      "binaryDir": "${sourceDir}/build-clang-tidy",
      "cacheVariables": { "BUILD_WITH_CLANG_TIDY": "ON" }
    },
    {
      "name": "configure-gcc-14-debug",
      "binaryDir": "${sourceDir}/build-gcc-14-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "/usr/bin/gcc-14", "CMAKE_CXX_COMPILER": "/usr/bin/g++-14" }
    },
    {
      "name": "configure-gcc-snapshot-debug",
      "binaryDir": "${sourceDir}/build-gcc-snapshot-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "/usr/lib/gcc-snapshot/bin/gcc", "CMAKE_CXX_COMPILER": "/usr/lib/gcc-snapshot/bin/g++" }
    },
    {
      "name": "configure-windows-msvc",
      "binaryDir": "${sourceDir}/build-windows-msvc",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_TESTING": "OFF",
        "SKIP_ASAN": "ON",
        "SKIP_NON_ASAN": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "configure-windows-msvc-asan",
      "binaryDir": "${sourceDir}/build-windows-msvc-asan",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_TESTING": "OFF",
        "SKIP_ASAN": "OFF",
        "SKIP_NON_ASAN": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-asan",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/src/windows/vcpkg-triplets"
      }
    },
    {
      "name": "configure-windows-ninja-debug",
      "binaryDir": "${sourceDir}/build-windows-ninja-debug-non-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "SKIP_ASAN": "ON",
        "SKIP_NON_ASAN": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "generator": "Ninja"
    },
    {
      "name": "configure-windows-ninja-release",
      "binaryDir": "${sourceDir}/build-windows-ninja-release-non-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "SKIP_ASAN": "ON",
        "SKIP_NON_ASAN": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "generator": "Ninja"
    },
    {
      "name": "configure-windows-ninja-debug-asan",
      "binaryDir": "${sourceDir}/build-windows-ninja-debug-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "SKIP_ASAN": "OFF",
        "SKIP_NON_ASAN": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-asan",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/src/windows/vcpkg-triplets"
      },
      "generator": "Ninja"
    },
    {
      "name": "configure-windows-ninja-release-asan",
      "binaryDir": "${sourceDir}/build-windows-ninja-release-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "SKIP_ASAN": "OFF",
        "SKIP_NON_ASAN": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-asan",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/src/windows/vcpkg-triplets"
      },
      "generator": "Ninja"
    },
    {
      "name": "configure-android-base",
      "hidden": true,
      "toolchainFile": "$env{HOME}/android-sdk/ndk/30.0.14904198/build/cmake/android.toolchain.cmake",
      "cacheVariables": { "ANDROID_PLATFORM": "android-26", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "configure-android-arm64-v8a-debug",
      "inherits": "configure-android-base",
      "binaryDir": "${sourceDir}/build-android-arm64-v8a-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "configure-android-x86_64-debug",
      "inherits": "configure-android-base",
      "binaryDir": "${sourceDir}/build-android-x86_64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ANDROID_ABI": "x86_64" }
    },
    {
      "name": "configure-android-arm64-v8a-release",
      "inherits": "configure-android-base",
      "binaryDir": "${sourceDir}/build-android-arm64-v8a-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "configure-android-x86_64-release",
      "inherits": "configure-android-base",
      "binaryDir": "${sourceDir}/build-android-x86_64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ANDROID_ABI": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "build-clang-debug", "configurePreset": "configure-clang-debug", "jobs": 16 },
    { "name": "build-clang-tidy", "configurePreset": "configure-clang-tidy", "jobs": 16 },
    { "name": "build-gcc-14-debug", "configurePreset": "configure-gcc-14-debug", "jobs": 8 },
    { "name": "build-gcc-snapshot-debug", "configurePreset": "configure-gcc-snapshot-debug", "jobs": 8 },
    { "name": "build-windows-msvc-debug", "configurePreset": "configure-windows-msvc", "configuration": "Debug", "jobs": 8 },
    { "name": "build-windows-msvc-debug-asan", "configurePreset": "configure-windows-msvc-asan", "configuration": "Debug", "jobs": 8 },
    { "name": "build-windows-msvc-release", "configurePreset": "configure-windows-msvc", "configuration": "Release", "jobs": 8 },
    { "name": "build-windows-msvc-release-asan", "configurePreset": "configure-windows-msvc-asan", "configuration": "Release", "jobs": 8 },
    { "name": "build-windows-ninja-debug", "configurePreset": "configure-windows-ninja-debug", "jobs": 8 },
    { "name": "build-windows-ninja-release", "configurePreset": "configure-windows-ninja-release", "jobs": 8 },
    { "name": "build-windows-ninja-debug-asan", "configurePreset": "configure-windows-ninja-debug-asan", "jobs": 8 },
    { "name": "build-windows-ninja-release-asan", "configurePreset": "configure-windows-ninja-release-asan", "jobs": 8 },
    { "name": "build-android-arm64-v8a-debug", "configurePreset": "configure-android-arm64-v8a-debug", "jobs": 16 },
    { "name": "build-android-x86_64-debug", "configurePreset": "configure-android-x86_64-debug", "jobs": 16 },
    { "name": "build-android-arm64-v8a-release", "configurePreset": "configure-android-arm64-v8a-release", "jobs": 16 },
    { "name": "build-android-x86_64-release", "configurePreset": "configure-android-x86_64-release", "jobs": 16 }
  ],
  "testPresets": [
    { "name": "test-clang-debug", "configurePreset": "configure-clang-debug" },
    { "name": "test-gcc-14-debug", "configurePreset": "configure-gcc-14-debug" },
    { "name": "test-gcc-snapshot-debug", "configurePreset": "configure-gcc-snapshot-debug" },
    { "name": "test-windows-ninja-debug-asan", "configurePreset": "configure-windows-ninja-debug-asan" },
    { "name": "test-windows-ninja-release-asan", "configurePreset": "configure-windows-ninja-release-asan" }
  ],
  "workflowPresets": [
    {
      "name": "clang-debug",
      "steps": [
        { "type": "configure", "name": "configure-clang-debug" },
        { "type": "build", "name": "build-clang-debug" },
        { "type": "test", "name": "test-clang-debug" }
      ]
    },
    {
      "name": "gcc-14-debug",
      "steps": [
        { "type": "configure", "name": "configure-gcc-14-debug" },
        { "type": "build", "name": "build-gcc-14-debug" },
        { "type": "test", "name": "test-gcc-14-debug" }
      ]
    },
    {
      "name": "gcc-snapshot-debug",
      "steps": [
        { "type": "configure", "name": "configure-gcc-snapshot-debug" },
        { "type": "build", "name": "build-gcc-snapshot-debug" },
        { "type": "test", "name": "test-gcc-snapshot-debug" }
      ]
    },
    {
      "name": "windows-msvc-debug",
      "steps": [
        { "type": "configure", "name": "configure-windows-msvc" },
        { "type": "build", "name": "build-windows-msvc-debug" }
      ]
    },
    {
      "name": "windows-msvc-debug-asan",
      "steps": [
        { "type": "configure", "name": "configure-windows-msvc-asan" },
        { "type": "build", "name": "build-windows-msvc-debug-asan" }
      ]
    },
    {
      "name": "windows-msvc-release",
      "steps": [
        { "type": "configure", "name": "configure-windows-msvc" },
        { "type": "build", "name": "build-windows-msvc-release" }
      ]
    },
    {
      "name": "windows-msvc-release-asan",
      "steps": [
        { "type": "configure", "name": "configure-windows-msvc-asan" },
        { "type": "build", "name": "build-windows-msvc-release-asan" }
      ]
    },
    {
      "name": "windows-ninja-debug",
      "steps": [
        { "type": "configure", "name": "configure-windows-ninja-debug" },
        { "type": "build", "name": "build-windows-ninja-debug" }
      ]
    },
    {
      "name": "windows-ninja-release",
      "steps": [
        { "type": "configure", "name": "configure-windows-ninja-release" },
        { "type": "build", "name": "build-windows-ninja-release" }
      ]
    },
    {
      "name": "windows-ninja-debug-asan",
      "steps": [
        { "type": "configure", "name": "configure-windows-ninja-debug-asan" },
        { "type": "build", "name": "build-windows-ninja-debug-asan" },
        { "type": "test", "name": "test-windows-ninja-debug-asan" }
      ]
    },
    {
      "name": "windows-ninja-release-asan",
      "steps": [
        { "type": "configure", "name": "configure-windows-ninja-release-asan" },
        { "type": "build", "name": "build-windows-ninja-release-asan" },
        { "type": "test", "name": "test-windows-ninja-release-asan" }
      ]
    },
    {
      "name": "android-arm64-v8a-debug",
      "steps": [
        { "type": "configure", "name": "configure-android-arm64-v8a-debug" },
        { "type": "build", "name": "build-android-arm64-v8a-debug" }
      ]
    },
    {
      "name": "android-x86_64-debug",
      "steps": [
        { "type": "configure", "name": "configure-android-x86_64-debug" },
        { "type": "build", "name": "build-android-x86_64-debug" }
      ]
    },
    {
      "name": "android-arm64-v8a-release",
      "steps": [
        { "type": "configure", "name": "configure-android-arm64-v8a-release" },
        { "type": "build", "name": "build-android-arm64-v8a-release" }
      ]
    },
    {
      "name": "android-x86_64-release",
      "steps": [
        { "type": "configure", "name": "configure-android-x86_64-release" },
        { "type": "build", "name": "build-android-x86_64-release" }
      ]
    }
  ]
}