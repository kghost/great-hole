{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "launch great-hole",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/great-hole",
            "console": "integratedTerminal",
            "initCommands": [
                "process handle SIGINT --stop false --notify false --pass true"
            ],
            "args": [
                "example.lua"
            ],
            "cwd": "${workspaceFolder}",
            "sourceMap": [
                [
                    ".",
                    "${workspaceFolder}"
                ]
            ]
        },
        {
            "name": "(lldb-dap) Launch test",
            "type": "lldb-dap",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "program": "${cmake.testProgram}",
            "initCommands": [
                "settings set target.process.follow-fork-mode child"
            ],
            "args": [
                "${cmake.testArgs}"
            ],
            "sourceMap": [
                [
                    ".",
                    "${workspaceFolder}"
                ]
            ]
        },
        {
            "name": "(cppvsdbg) Launch test",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${cmake.testProgram}",
            "args": [
                "${cmake.testArgs}"
            ]
        },
        {
            "name": "(cppvsdbg) Launch exe",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-windows-ninja-debug-asan/src/windows/network/tools/net-interface-dump-asan.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
    ]
}